<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<title>小氣薄</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, "PingFang HK", "Microsoft JhengHei", sans-serif;
    background: linear-gradient(180deg, #FBF4EC 0%, #F5F1E8 100%);
    margin: 0;
    padding: 28px 18px 60px;
    color: #2c2c2a;
  }
  .wrap { max-width: 620px; margin: 0 auto; }

  .header { text-align: center; margin-bottom: 26px; }
  .header-icon {
    width: 52px; height: 52px;
    margin: 0 auto 10px;
    border-radius: 16px;
    background: #26215C;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px;
  }
  h1 { font-size: 24px; font-weight: 500; margin: 0 0 4px; letter-spacing: 0.5px; }
  .subtitle { font-size: 13px; color: #93917f; }

  .card {
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid #ECE7DA;
    box-shadow: 0 2px 10px rgba(60, 52, 30, 0.04);
    padding: 20px;
    margin-bottom: 18px;
  }
  .card-title {
    font-size: 12px;
    font-weight: 500;
    color: #a19d8a;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 14px;
  }

  /* people chips */
  .people-list { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .person-chip {
    display: flex; align-items: center; gap: 6px;
    background: #FAF6EE; border: 1px solid #ECE7DA; border-radius: 999px;
    padding: 6px 6px 6px 12px; font-size: 13px; color: #4a4838;
  }
  .person-chip .avatar {
    width: 18px; height: 18px; border-radius: 50%;
    background: #D4537E; color: white; font-size: 10px; font-weight: 500;
    display: flex; align-items: center; justify-content: center;
  }
  .person-chip button {
    border: none; background: none; color: #c2bfad; cursor: pointer; font-size: 15px; padding: 0 4px; line-height: 1;
  }
  .person-chip button:hover { color: #D85A30; }
  .add-person-row { display: flex; gap: 8px; }
  .add-person-row input {
    flex: 1; padding: 9px 12px; border: 1px solid #ECE7DA; border-radius: 10px; font-size: 13px; background: #FAF6EE;
  }
  .add-person-row input:focus { outline: none; border-color: #26215C; background: white; }
  .add-person-row button {
    padding: 9px 16px; border: none; border-radius: 10px; background: #26215C; color: white; font-size: 13px; font-weight: 500; cursor: pointer;
  }
  .add-person-row button:active { transform: scale(0.97); }

  /* bar chart */
  .bar-row { margin-bottom: 18px; }
  .bar-row:last-child { margin-bottom: 0; }
  .bar-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
  .bar-name-wrap { display: flex; align-items: center; gap: 7px; }
  .bar-avatar {
    width: 20px; height: 20px; border-radius: 50%;
    color: white; font-size: 10px; font-weight: 500;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .bar-name { font-size: 14px; font-weight: 500; }
  .bar-value { font-size: 16px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .bar-value.neg { color: #B23A3A; }
  .bar-value.pos { color: #4C8A2E; }
  .bar-value.zero { color: #b4b2a9; }
  .bar-track {
    position: relative;
    height: 20px;
    background: #F1EDE2;
    border-radius: 10px;
    overflow: hidden;
  }
  .bar-center-line {
    position: absolute;
    top: 0; bottom: 0; left: 50%;
    width: 1.5px;
    background: #d8d3c3;
    z-index: 1;
  }
  .bar-fill {
    position: absolute;
    top: 0; bottom: 0;
    transition: width 0.35s ease;
  }
  .bar-fill.pos { left: 50%; background: linear-gradient(90deg, #97C459, #7CB342); border-radius: 0 10px 10px 0; }
  .bar-fill.neg { right: 50%; background: linear-gradient(270deg, #E8837F, #D96A65); border-radius: 10px 0 0 10px; }

  /* add form */
  .quick-btns { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 14px; }
  .quick-btn {
    font-size: 12.5px; padding: 6px 13px; border-radius: 999px; border: 1px solid #ECE7DA;
    background: #FAF6EE; cursor: pointer; color: #6b6858; transition: all 0.15s;
  }
  .quick-btn.sel { background: #26215C; color: white; border-color: #26215C; }
  .form-row { display: flex; gap: 8px; margin-bottom: 10px; }
  .form-row:last-child { margin-bottom: 0; }
  select, input[type=text], input[type=number] {
    padding: 10px 12px; border: 1px solid #ECE7DA; border-radius: 10px; font-size: 14px; background: #FAF6EE;
  }
  select:focus, input:focus { outline: none; border-color: #26215C; background: white; }
  select { flex: 1.3; }
  input[type=text] { flex: 2; }
  input[type=number] { width: 84px; text-align: center; }
  button.submit {
    width: 100%; padding: 12px; border: none; border-radius: 10px;
    background: #26215C; color: white; font-size: 14.5px; font-weight: 500; cursor: pointer;
    margin-top: 4px; transition: transform 0.1s;
  }
  button.submit:active { transform: scale(0.98); }

  /* history */
  .history-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 4px;
    border-bottom: 1px solid #F1EDE2;
    font-size: 13px;
  }
  .history-item:last-child { border-bottom: none; }
  .hist-left { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
  .hist-avatar {
    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    color: white; font-size: 12px; font-weight: 500;
    display: flex; align-items: center; justify-content: center;
  }
  .hist-text { min-width: 0; }
  .hist-who { font-weight: 500; }
  .hist-reason { color: #93917f; margin-top: 1px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hist-date { color: #c2bfad; font-size: 11px; margin-top: 1px; }
  .hist-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; margin-left: 8px; }
  .hist-points { font-weight: 500; font-size: 15.5px; font-variant-numeric: tabular-nums; }
  .hist-points.neg { color: #B23A3A; }
  .hist-points.pos { color: #4C8A2E; }
  .del-btn { background: none; border: none; color: #d8d3c3; font-size: 16px; cursor: pointer; padding: 0; }
  .del-btn:hover { color: #D85A30; }
  .empty { text-align: center; color: #b4b2a9; font-size: 13px; padding: 24px 10px; }
  .loading { text-align: center; color: #b4b2a9; padding: 30px; }
</style>
</head>
<body>
<div class="wrap">
  <div class="header">
    <div class="header-icon">🧾</div>
    <h1>小氣薄</h1>
    <div class="subtitle">記低你哋之間嘅加分扣分，一齊開連結就同步睇到</div>
  </div>

  <div class="card">
    <div class="card-title">參與嘅人</div>
    <div class="people-list" id="peopleList"></div>
    <div class="add-person-row">
      <input type="text" id="newPersonInput" placeholder="加多個人，例如：中可因">
      <button id="addPersonBtn">加入</button>
    </div>
  </div>

  <div class="card">
    <div class="card-title">分數榜</div>
    <div id="scoreboard"><div class="loading">載入緊...</div></div>
  </div>

  <div class="card">
    <div class="card-title">記一筆</div>
    <div class="quick-btns" id="quickBtns"></div>
    <div class="form-row">
      <select id="whoSelect"></select>
      <input type="number" id="pointsInput" value="-1" step="1">
    </div>
    <div class="form-row">
      <input type="text" id="reasonInput" placeholder="原因，例如：遲到咗15分鐘">
    </div>
    <button class="submit" id="addBtn">記低呢一筆</button>
  </div>

  <div class="card">
    <div class="card-title">歷史記錄</div>
    <div id="historyList"><div class="loading">載入緊...</div></div>
  </div>
</div>

<script>
const STORAGE_KEY = 'grudge-data-v2';
let state = {
  people: [
    { id: 'p0', name: '我' },
    { id: 'p1', name: '中可因' },
    { id: 'p2', name: '你雲停' },
    { id: 'p3', name: '你明移' }
  ],
  entries: []
};
let selectedQuick = null;

const quickPresets = [
  { label: '遲到', points: -1 },
  { label: '爽約', points: -3 },
  { label: '講大話', points: -2 },
  { label: '請食飯', points: 2 },
  { label: '幫大忙', points: 3 },
  { label: '道歉', points: 1 }
];

const avatarColors = ['#D4537E', '#378ADD', '#1D9E75', '#BA7517', '#7F77DD', '#D85A30'];
function colorFor(id) {
  let hash = 0;
  for (let i = 0; i < id.length; i++) hash = (hash * 31 + id.charCodeAt(i)) >>> 0;
  return avatarColors[hash % avatarColors.length];
}
function initialsFor(name) {
  return name.trim().slice(0, 1) || '?';
}

async function loadState() {
  try {
    const res = await window.storage.get(STORAGE_KEY, true);
    if (res && res.value) {
      const parsed = JSON.parse(res.value);
      if (parsed.people && parsed.people.length) state = parsed;
    }
  } catch (e) {
    console.log('未有舊資料，用預設值');
  }
  render();
}

async function saveState() {
  try {
    await window.storage.set(STORAGE_KEY, JSON.stringify(state), true);
  } catch (e) {
    console.error('儲存失敗', e);
  }
}

function calcScore(personId) {
  return state.entries.filter(e => e.who === personId).reduce((sum, e) => sum + e.points, 0);
}

function escapeHtml(s) {
  const d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML;
}

function renderPeopleList() {
  const wrap = document.getElementById('peopleList');
  wrap.innerHTML = state.people.map(p => `
    <div class="person-chip">
      <span class="avatar" style="background:${colorFor(p.id)}">${escapeHtml(initialsFor(p.name))}</span>
      ${escapeHtml(p.name)}
      <button onclick="removePerson('${p.id}')">✕</button>
    </div>
  `).join('');
}

function renderScoreboard() {
  const board = document.getElementById('scoreboard');
  if (state.people.length === 0) {
    board.innerHTML = '<div class="empty">未有人，先加返個朋友</div>';
    return;
  }
  const scored = state.people.map(p => ({ p, score: calcScore(p.id) }));
  scored.sort((a, b) => b.score - a.score);
  const maxAbs = Math.max(1, ...scored.map(s => Math.abs(s.score)));
  board.innerHTML = scored.map(({ p, score }) => {
    const vcls = score < 0 ? 'neg' : score > 0 ? 'pos' : 'zero';
    const fillCls = score < 0 ? 'neg' : 'pos';
    const widthPct = Math.round((Math.abs(score) / maxAbs) * 50);
    return `
      <div class="bar-row">
        <div class="bar-top">
          <div class="bar-name-wrap">
            <span class="bar-avatar" style="background:${colorFor(p.id)}">${escapeHtml(initialsFor(p.name))}</span>
            <span class="bar-name">${escapeHtml(p.name)}</span>
          </div>
          <span class="bar-value ${vcls}">${score > 0 ? '+' : ''}${score}</span>
        </div>
        <div class="bar-track">
          <div class="bar-center-line"></div>
          ${score !== 0 ? `<div class="bar-fill ${fillCls}" style="width:${widthPct}%"></div>` : ''}
        </div>
      </div>
    `;
  }).join('');
}

function renderWhoSelect() {
  const sel = document.getElementById('whoSelect');
  sel.innerHTML = state.people.map(p => `<option value="${p.id}">${escapeHtml(p.name)}</option>`).join('');
}

function renderQuickBtns() {
  const wrap = document.getElementById('quickBtns');
  wrap.innerHTML = '';
  quickPresets.forEach((p, i) => {
    const btn = document.createElement('button');
    btn.className = 'quick-btn' + (selectedQuick === i ? ' sel' : '');
    btn.textContent = `${p.label} ${p.points > 0 ? '+' : ''}${p.points}`;
    btn.onclick = () => {
      selectedQuick = (selectedQuick === i) ? null : i;
      if (selectedQuick !== null) {
        document.getElementById('pointsInput').value = p.points;
        document.getElementById('reasonInput').value = p.label;
      }
      renderQuickBtns();
    };
    wrap.appendChild(btn);
  });
}

function renderHistory() {
  const list = document.getElementById('historyList');
  if (state.entries.length === 0) {
    list.innerHTML = '<div class="empty">仲未有記錄，快啲記低第一筆啦</div>';
    return;
  }
  const sorted = [...state.entries].sort((x, y) => y.ts - x.ts);
  list.innerHTML = sorted.map(e => {
    const person = state.people.find(p => p.id === e.who);
    const name = person ? person.name : '(已刪除嘅人)';
    const color = person ? colorFor(person.id) : '#b4b2a9';
    const initials = person ? initialsFor(person.name) : '?';
    const date = new Date(e.ts).toLocaleString('zh-HK', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    return `
      <div class="history-item">
        <div class="hist-left">
          <span class="hist-avatar" style="background:${color}">${escapeHtml(initials)}</span>
          <div class="hist-text">
            <div class="hist-who">${escapeHtml(name)}</div>
            <div class="hist-reason">${escapeHtml(e.reason || '(無註明原因)')}</div>
            <div class="hist-date">${date}</div>
          </div>
        </div>
        <div class="hist-right">
          <span class="hist-points ${e.points < 0 ? 'neg' : 'pos'}">${e.points > 0 ? '+' : ''}${e.points}</span>
          <button class="del-btn" onclick="deleteEntry(${e.id})">✕</button>
        </div>
      </div>
    `;
  }).join('');
}

function render() {
  renderPeopleList();
  renderScoreboard();
  renderWhoSelect();
  renderQuickBtns();
  renderHistory();
}

async function removePerson(id) {
  state.people = state.people.filter(p => p.id !== id);
  await saveState();
  render();
}

async function deleteEntry(id) {
  state.entries = state.entries.filter(e => e.id !== id);
  await saveState();
  render();
}

document.getElementById('addPersonBtn').addEventListener('click', async () => {
  const input = document.getElementById('newPersonInput');
  const name = input.value.trim();
  if (!name) return;
  state.people.push({ id: 'p' + Date.now(), name });
  input.value = '';
  await saveState();
  render();
});

document.getElementById('addBtn').addEventListener('click', async () => {
  const who = document.getElementById('whoSelect').value;
  const points = parseInt(document.getElementById('pointsInput').value, 10) || 0;
  const reason = document.getElementById('reasonInput').value.trim();
  if (points === 0 || !who) return;
  state.entries.push({ id: Date.now(), who, points, reason, ts: Date.now() });
  await saveState();
  document.getElementById('reasonInput').value = '';
  selectedQuick = null;
  render();
});

loadState();
</script>
</body>
</html>
